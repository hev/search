#!/usr/bin/env bash
# Build the existing fixture release from its immutable public source. MinIO
# removed its public container images; never substitute an unverified mirror.
set -Eeuo pipefail
MINIO_COMMIT=07c3a429bfed433e49018cb0f78a52145d4bedeb
output="$(realpath -m "${1:?usage: build-test-minio OUTPUT_BINARY}")"
mkdir -p "$(dirname "$output")"
source_dir="$(mktemp -d)"
trap 'rm -rf "$source_dir"' EXIT
git -C "$source_dir" init -q
git -C "$source_dir" fetch -q --depth 1 https://github.com/minio/minio.git "$MINIO_COMMIT"
git -C "$source_dir" checkout -q --detach FETCH_HEAD
test "$(git -C "$source_dir" rev-parse HEAD)" = "$MINIO_COMMIT"
(cd "$source_dir" && GOTOOLCHAIN=local go build -p 8 -trimpath -o "$output" .)
"$output" --version
